# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ADMIN_KEY: Secret key protecting blog post creation (POST /api/blog).
# Required — without it, article creation returns 503.
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Server port (default: 3000).
PORT="3000"

# API_ONLY: Set to "true" on a backend-only host (e.g. Render) so the server
# does not try to serve the frontend (it's hosted on GitHub Pages).
# API_ONLY="true"

# CORS: Origins allowed to call this API from a browser.
# Comma-separated list, e.g. "https://tchinda-bl4z3.github.io".
# Leave unset ("*") to allow any origin.
ALLOWED_ORIGINS="*"

# DATA_DIR / DATABASE_PATH: Where the SQLite file lives.
# On hosts with a persistent volume, point DATA_DIR to the mount path.
# DATA_DIR="/var/data"
# DATABASE_PATH="/var/data/portfolio.db"

# VITE_API_BASE: Frontend build-time API URL used on GitHub Pages.
# Set it as a GitHub Actions *variable* (Settings > Secrets and variables > Actions > Variables).
# Example: "https://my-portfolio-api.onrender.com"
# VITE_API_BASE="https://my-portfolio-api.onrender.com"

# CONTACT FORM (optional). If SMTP is configured, messages sent via the
# contact form are saved in SQLite AND forwarded by email. Without SMTP the
# messages are still persisted in the local database.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="MY_SMTP_USER"
SMTP_PASS="MY_SMTP_PASSWORD_OR_APP_PASSWORD"
CONTACT_TO_EMAIL="pierre.tchinda@facsciences-uy1.cm"
